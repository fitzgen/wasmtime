test compile precise-output
test run
set regalloc_checker=true
set regalloc_lazy_critical_edges=true
target x86_64

function %crit(i32, i64, i64) -> i64 system_v {
block0(v0: i32, v1: i64, v2: i64):
    brif v0, block1, block2(v2, v1)

block1:
    v3 = iadd v1, v2
    brif v3, block2(v1, v2), block3

block2(v4: i64, v5: i64):
    v6 = isub v4, v5
    return v6

block3:
    v7 = iconst.i64 99
    return v7
}

